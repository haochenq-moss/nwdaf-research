{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nwdaf-research:fuzz-run:v1",
  "title": "Fuzz-to-NWDAF Fuzz Run Record",
  "description": "Provenance for one bounded fuzz execution. Execution, coverage, reproduction, bug confirmation, and vulnerability assessment remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "campaignId", "source", "target", "input", "toolchain", "configuration", "timeWindow", "execution", "coverage", "reproduction", "bugReview", "securityReview"],
  "properties": {
    "schemaVersion": {"const": "fuzz-run-v1"},
    "runId": {"type": "string", "minLength": 1},
    "campaignId": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSource", "free5gcCommit", "harnessPath", "harnessSha256", "fuzzEngine"],
      "properties": {
        "inputSource": {"enum": ["ordinary", "llm_suggested"]},
        "generatorModel": {"type": ["string", "null"]},
        "promptVersion": {"type": ["string", "null"]},
        "free5gcCommit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "harnessPath": {"type": "string", "minLength": 1},
        "harnessSha256": {"$ref": "#/$defs/sha256"},
        "fuzzEngine": {"enum": ["go-native", "aflplusplus", "other"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "function", "language"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "language": {"const": "go"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "corpusPath", "sha256", "sizeBytes"],
      "properties": {
        "inputId": {"type": "string", "minLength": 1},
        "corpusPath": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goVersion", "platform"],
      "properties": {
        "goVersion": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "seed", "maxDurationSeconds", "maxInputBytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer"},
        "maxDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maxInputBytes": {"type": "integer", "minimum": 1}
      }
    },
    "timeWindow": {"$ref": "#/$defs/timeWindow"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "signal", "timeoutSeconds"],
      "properties": {
        "status": {"enum": ["completed", "crash", "hang", "timeout", "error"]},
        "exitCode": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"]},
        "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "crashSignature": {"type": ["string", "null"]},
        "artifactPath": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "before", "after", "delta", "artifactPath"],
      "properties": {
        "status": {"enum": ["collected", "unavailable", "error"]},
        "before": {"type": ["integer", "null"], "minimum": 0},
        "after": {"type": ["integer", "null"], "minimum": 0},
        "delta": {"type": ["integer", "null"]},
        "artifactPath": {"type": ["string", "null"]}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "oracleId", "artifactPath"],
      "properties": {
        "status": {"enum": ["not_attempted", "reproduced", "not_reproduced", "expected_rejection", "inconclusive"]},
        "oracleId": {"type": ["string", "null"]},
        "artifactPath": {"type": ["string", "null"]}
      }
    },
    "bugReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidenceRefs"],
      "properties": {
        "status": {"enum": ["unreviewed", "needs_more_evidence", "confirmed_bug", "not_a_bug"]},
        "reviewer": {"type": ["string", "null"]},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidenceRefs"],
      "properties": {
        "status": {"enum": ["not_assessed", "not_a_vulnerability", "potential_vulnerability", "confirmed_vulnerability"]},
        "reviewer": {"type": ["string", "null"]},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"properties": {"inputSource": {"const": "llm_suggested"}}, "required": ["inputSource"]}}, "required": ["source"]},
      "then": {"properties": {"source": {"properties": {"generatorModel": {"type": "string", "minLength": 1}}, "required": ["generatorModel"]}}}
    },
    {
      "if": {"properties": {"execution": {"properties": {"status": {"const": "crash"}}, "required": ["status"]}}, "required": ["execution"]},
      "then": {"properties": {"execution": {"anyOf": [
        {"properties": {"signal": {"type": "string", "minLength": 1}}, "required": ["signal"]},
        {"properties": {"crashSignature": {"type": "string", "minLength": 1}}, "required": ["crashSignature"]}
      ]}}}
    },
    {
      "if": {"properties": {"execution": {"properties": {"status": {"const": "hang"}}, "required": ["status"]}}, "required": ["execution"]},
      "then": {"properties": {"execution": {"properties": {"artifactPath": {"type": "string", "minLength": 1}}, "required": ["artifactPath"]}}}
    },
    {
      "if": {"properties": {"coverage": {"properties": {"status": {"const": "collected"}}, "required": ["status"]}}, "required": ["coverage"]},
      "then": {"properties": {"coverage": {"properties": {
        "before": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0},
        "delta": {"type": "integer"}
      }}}}
    },
    {
      "if": {"properties": {"bugReview": {"properties": {"status": {"const": "confirmed_bug"}}, "required": ["status"]}}, "required": ["bugReview"]},
      "then": {
        "properties": {
          "reproduction": {"properties": {"status": {"const": "reproduced"}}, "required": ["status"]},
          "bugReview": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "evidenceRefs": {"type": "array", "minItems": 1}}}
        }
      }
    },
    {
      "if": {"properties": {"securityReview": {"properties": {"status": {"enum": ["potential_vulnerability", "confirmed_vulnerability"]}}, "required": ["status"]}}, "required": ["securityReview"]},
      "then": {"properties": {"securityReview": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "evidenceRefs": {"type": "array", "minItems": 1}}}}}
    },
    {
      "if": {"properties": {"securityReview": {"properties": {"status": {"const": "confirmed_vulnerability"}}, "required": ["status"]}}, "required": ["securityReview"]},
      "then": {"properties": {"bugReview": {"properties": {"status": {"const": "confirmed_bug"}}, "required": ["status"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    }
  }
}
